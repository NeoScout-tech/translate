msgid "A powerful network reconnaissance tool for scanning WiFi, pinging hosts, and probing ports. Built for hackers, by hackers."
msgstr "Мощный инструмент сетевой разведки для сканирования WiFi, пинга хостов и проверки портов. Создан хакерами для хакеров."

msgid "Why ScoutMap?"
msgstr "Почему ScoutMap?"

msgid "Network Recon"
msgstr "Сетевая разведка"

msgid "Scan WiFi networks, ping hosts, and probe open ports to uncover vulnerabilities."
msgstr "Сканируйте WiFi сети, пингуйте хосты и проверяйте открытые порты, чтобы выявить уязвимости."

msgid "Open-Source"
msgstr "Открытый исходный код"

msgid "Built on ESP8266, soon ESP32. Fork it, tweak it, make it yours."
msgstr "Создан на ESP8266, скоро на ESP32. Сделайте форк, настройте, присвойте себе."

msgid "Report Uploads"
msgstr "Загрузка отчетов"

msgid "Send scan results to the NeoScout server for detailed analysis."
msgstr "Отправляйте результаты сканирования на сервер NeoScout для детального анализа."

msgid "WiFi Scanning"
msgstr "Сканирование WiFi"

msgid "Detect nearby WiFi networks and connect seamlessly."
msgstr "Обнаруживайте ближайшие WiFi сети и подключайтесь без проблем."

msgid "Host Scanning"
msgstr "Сканирование хостов"

msgid "Ping IPs or URLs to check host availability locally or remotely."
msgstr "Пингуйте IP или URL, чтобы проверить доступность хостов локально или удаленно."

msgid "Port Scanning"
msgstr "Сканирование портов"

msgid "Probe single ports, ranges, or popular ports like 80, 443, and more."
msgstr "Проверяйте отдельные порты, диапазоны или популярные порты, такие как 80, 443 и другие."

msgid "Report Upload"
msgstr "Загрузка отчетов"

msgid "Upload JSON reports to the NeoScout server for further analysis."
msgstr "Загружайте отчеты в формате JSON на сервер NeoScout для дальнейшего анализа."

msgid "Debug Mode"
msgstr "Режим отладки"

msgid "Detailed logs in English for troubleshooting and optimization."
msgstr "Подробные логи на английском для устранения неполадок и оптимизации."

msgid "Serial Interface"
msgstr "Серийный интерфейс"

msgid "Control scans with simple commands like `scan`, `ping`, or `stop`."
msgstr "Управляйте сканированием с помощью простых команд, таких как `scan`, `ping` или `stop`."

msgid "Get Started with ScoutMap"
msgstr "Начало работы с ScoutMap"

msgid "Install PlatformIO"
msgstr "Установите PlatformIO"

msgid "Use the PlatformIO IDE with VS Code to set up your environment."
msgstr "Используйте IDE PlatformIO с VS Code для настройки окружения."

msgid "Clone the Repo"
msgstr "Склонируйте репозиторий"

msgid "Grab the ScoutMap code from GitHub and open it in PlatformIO."
msgstr "Скачайте код ScoutMap с GitHub и откройте его в PlatformIO."

msgid "Upload to ESP"
msgstr "Загрузите на ESP"

msgid "Connect your ESP board and upload the firmware."
msgstr "Подключите плату ESP и загрузите прошивку."

msgid "Run Commands"
msgstr "Запустите команды"

msgid "Use a serial terminal to send commands like `scan all all` or `ping 8.8.8.8`."
msgstr "Используйте серийный терминал для отправки команд, таких как `scan all all` или `ping 8.8.8.8`."

msgid "Full Installation Guide"
msgstr "Полное руководство по установке"

msgid "ScoutMap Roadmap"
msgstr "Дорожная карта ScoutMap"

msgid "Full host and port scanning, WiFi connection, and report uploads."
msgstr "Полное сканирование хостов и портов, подключение к WiFi и загрузка отчетов."

msgid "Web Interface"
msgstr "Веб-интерфейс"

msgid "Browser-based control with real-time scan visualization."
msgstr "Управление через браузер с визуализацией сканирования в реальном времени."

msgid "Advanced Scanning"
msgstr "Расширенное сканирование"

msgid "Service detection, OS fingerprinting, and stealth modes."
msgstr "Обнаружение сервисов, определение ОС и скрытые режимы сканирования."

msgid "Mobile App"
msgstr "Мобильное приложение"

msgid "Control ScoutMap via a mobile app with push notifications."
msgstr "Управляйте ScoutMap через мобильное приложение с push-уведомлениями."

msgid "Cloud Integration"
msgstr "Интеграция с облаком"

msgid "Store and analyze scan reports in a cloud dashboard."
msgstr "Храните и анализируйте отчеты сканирования в облачной панели управления."

msgid "Join the NeoScout Crew"
msgstr "Присоединяйтесь к команде NeoScout"

msgid "Contribute to ScoutMap by fixing bugs, adding features, or suggesting ideas. Fork the repo and join the community!"
msgstr "Внесите вклад в ScoutMap, исправляя ошибки, добавляя функции или предлагая идеи. Сделайте форк репозитория и присоединяйтесь к сообществу!"

msgid "Contribute Now"
msgstr "Внести вклад сейчас"

msgid "Ready to Scan the Network?"
msgstr "Готовы сканировать сеть?"

msgid "Join the NeoScout Community and take control with ScoutMap!"
msgstr "Присоединяйтесь к сообществу NeoScout и управляйте с помощью ScoutMap!"